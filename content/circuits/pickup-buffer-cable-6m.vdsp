schema: circuit-interchange/v3
audio:
  input: V1
  output: O1
  bypass: none
metadata:
  name: "Pickup, buffer, 6 m cable, 1 M load"
  description: "The same single-coil pickup, but 0.5 m of patch cable into a 2N3904 emitter-follower buffer, whose output drives the 6 m cable. The pickup now sees the buffer's input impedance instead of the cable; the cable is now driven by roughly a hundred ohms instead of a resonant coil."
source:
  format: vdsp
  version: "blog-buffer-article"
components:
  - id: V1
    kind: jack
    name: Input
    sourceTypeName: Circuit.Input
    origin:
      x: -460
      y: 80
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: tip
        node: 1
        position:
          x: -460
          y: 60
      - name: cathode
        role: sleeve
        node: 0
        position:
          x: -460
          y: 100
    properties:
      V0dBFS: "1 V"
      Name: "Input"
      Role: "input"
  - id: GND1
    kind: ground
    name: GND1
    sourceTypeName: Circuit.Ground
    origin:
      x: -460
      y: 160
    rotation: 0
    flipped: false
    terminals:
      - name: terminal
        role: ground
        node: 0
        position:
          x: -460
          y: 160
    properties:
      Name: "GND1"
  - id: VCC
    kind: rail
    name: VCC
    sourceTypeName: Circuit.Rail
    origin:
      x: -40
      y: 0
    rotation: 0
    flipped: false
    terminals:
      - name: terminal
        role: positive
        node: 5
        position:
          x: -40
          y: 0
    properties:
      Voltage: "9 V"
      Name: "VCC"
      Description: "9 V single supply, the pedal battery."
  - id: RDC
    kind: resistor
    name: RDC
    sourceTypeName: Circuit.Resistor
    origin:
      x: -380
      y: 60
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 1
        position:
          x: -400
          y: 60
      - name: cathode
        role: end
        node: 2
        position:
          x: -360
          y: 60
    properties:
      Resistance: "6k"
      Name: "RDC"
      Description: "Pickup DC winding resistance."
  - id: LP
    kind: inductor
    name: LP
    sourceTypeName: Circuit.Inductor
    origin:
      x: -300
      y: 60
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 2
        position:
          x: -320
          y: 60
      - name: cathode
        role: end
        node: 3
        position:
          x: -280
          y: 60
    properties:
      Inductance: "2.3"
      Name: "LP"
      Description: "Pickup coil inductance, 2.3 H."
  - id: CPATCH
    kind: capacitor
    name: CPATCH
    sourceTypeName: Circuit.Capacitor
    origin:
      x: -240
      y: 110
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 3
        position:
          x: -240
          y: 90
      - name: cathode
        role: end
        node: 0
        position:
          x: -240
          y: 130
    properties:
      Capacitance: "150p"
      Name: "CPATCH"
      Description: "100 pF winding capacitance plus 0.5 m of patch cable. This is all the pickup drives now."
  - id: CIN
    kind: capacitor
    name: CIN
    sourceTypeName: Circuit.Capacitor
    origin:
      x: -180
      y: 60
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 3
        position:
          x: -200
          y: 60
      - name: cathode
        role: end
        node: 4
        position:
          x: -160
          y: 60
    properties:
      Capacitance: "100n"
      Name: "CIN"
      Description: "Input coupling capacitor."
  - id: RB1
    kind: resistor
    name: RB1
    sourceTypeName: Circuit.Resistor
    origin:
      x: -120
      y: 20
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 5
        position:
          x: -120
          y: 0
      - name: cathode
        role: end
        node: 4
        position:
          x: -120
          y: 40
    properties:
      Resistance: "1Meg"
      Name: "RB1"
      Description: "Upper bias resistor."
  - id: RB2
    kind: resistor
    name: RB2
    sourceTypeName: Circuit.Resistor
    origin:
      x: -120
      y: 120
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 4
        position:
          x: -120
          y: 100
      - name: cathode
        role: end
        node: 0
        position:
          x: -120
          y: 140
    properties:
      Resistance: "1Meg"
      Name: "RB2"
      Description: "Lower bias resistor. With RB1 this sets the base at half the supply -- and sets the buffer's input impedance."
  - id: Q1
    kind: bjt
    name: Q1
    sourceTypeName: Circuit.BipolarJunctionTransistor
    origin:
      x: -40
      y: 80
    rotation: 0
    flipped: false
    terminals:
      - name: collector
        role: collector
        node: 5
        position:
          x: -30
          y: 60
      - name: emitter
        role: emitter
        node: 6
        position:
          x: -30
          y: 100
      - name: base
        role: base
        node: 4
        position:
          x: -60
          y: 80
    properties:
      Polarity: "npn"
      PartNumber: "2N3904"
      Name: "Q1"
      Description: "Emitter follower. Unity voltage gain, current gain of beta."
  - id: RE
    kind: resistor
    name: RE
    sourceTypeName: Circuit.Resistor
    origin:
      x: -40
      y: 140
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 6
        position:
          x: -40
          y: 120
      - name: cathode
        role: end
        node: 0
        position:
          x: -40
          y: 160
    properties:
      Resistance: "10k"
      Name: "RE"
      Description: "Emitter resistor, sets the standing current."
  - id: COUT
    kind: capacitor
    name: COUT
    sourceTypeName: Circuit.Capacitor
    origin:
      x: 40
      y: 100
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 6
        position:
          x: 20
          y: 100
      - name: cathode
        role: end
        node: 7
        position:
          x: 60
          y: 100
    properties:
      Capacitance: "1u"
      Name: "COUT"
      Description: "Output coupling capacitor."
  - id: CCABLE
    kind: capacitor
    name: CCABLE
    sourceTypeName: Circuit.Capacitor
    origin:
      x: 120
      y: 140
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 7
        position:
          x: 120
          y: 120
      - name: cathode
        role: end
        node: 0
        position:
          x: 120
          y: 160
    properties:
      Capacitance: "600p"
      Name: "CCABLE"
      Description: "6 m of cable at 100 pF per metre -- the same cable as the unbuffered circuit, now on the buffer's side of the chain."
  - id: RL
    kind: resistor
    name: RL
    sourceTypeName: Circuit.Resistor
    origin:
      x: 200
      y: 140
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: end
        node: 7
        position:
          x: 200
          y: 120
      - name: cathode
        role: end
        node: 0
        position:
          x: 200
          y: 160
    properties:
      Resistance: "1Meg"
      Name: "RL"
      Description: "Amp input impedance."
  - id: O1
    kind: jack
    name: Output
    sourceTypeName: Circuit.Speaker
    origin:
      x: 280
      y: 120
    rotation: 0
    flipped: false
    terminals:
      - name: anode
        role: tip
        node: 7
        position:
          x: 280
          y: 100
      - name: cathode
        role: sleeve
        node: 0
        position:
          x: 280
          y: 140
    properties:
      Impedance: "infinite"
      Name: "Output"
      Role: "output"
nodes:
  - id: 0
    role: ground
    members:
      - componentId: V1
        terminalName: cathode
      - componentId: GND1
        terminalName: terminal
      - componentId: CPATCH
        terminalName: cathode
      - componentId: RB2
        terminalName: cathode
      - componentId: RE
        terminalName: cathode
      - componentId: CCABLE
        terminalName: cathode
      - componentId: RL
        terminalName: cathode
      - componentId: O1
        terminalName: cathode
  - id: 1
    role: signal
    members:
      - componentId: V1
        terminalName: anode
      - componentId: RDC
        terminalName: anode
  - id: 2
    role: signal
    members:
      - componentId: RDC
        terminalName: cathode
      - componentId: LP
        terminalName: anode
  - id: 3
    role: signal
    members:
      - componentId: LP
        terminalName: cathode
      - componentId: CPATCH
        terminalName: anode
      - componentId: CIN
        terminalName: anode
  - id: 4
    role: signal
    members:
      - componentId: CIN
        terminalName: cathode
      - componentId: RB1
        terminalName: cathode
      - componentId: RB2
        terminalName: anode
      - componentId: Q1
        terminalName: base
  - id: 5
    role: power
    members:
      - componentId: VCC
        terminalName: terminal
      - componentId: RB1
        terminalName: anode
      - componentId: Q1
        terminalName: collector
  - id: 6
    role: signal
    members:
      - componentId: Q1
        terminalName: emitter
      - componentId: RE
        terminalName: anode
      - componentId: COUT
        terminalName: anode
  - id: 7
    role: signal
    members:
      - componentId: COUT
        terminalName: cathode
      - componentId: CCABLE
        terminalName: anode
      - componentId: RL
        terminalName: anode
      - componentId: O1
        terminalName: anode
